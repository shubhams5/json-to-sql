{
  "name": "json-to-sql",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhams5/json-to-sql"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:core && next dev --turbopack",
    "build:core": "npm run build -w @json-to-sql/core",
    "build:cli": "npm run build -w @json-to-sql/cli",
    "build:packages": "npm run build:core && npm run build:cli",
    "build": "npm run build:packages && next build --turbopack",
    "start": "npx --yes serve@14 out",
    "lint": "eslint",
    "test": "npm run test -w @json-to-sql/core",
    "test:e2e": "playwright test",
    "test:generated": "node scripts/validate-generated.mjs",
    "test:consumer": "node scripts/consumer-import.mjs",
    "cli": "npm run build:packages && node packages/cli/dist/cli.js",
    "pack:check": "npm pack -w @json-to-sql/core --dry-run && npm pack -w @json-to-sql/cli --dry-run"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@json-to-sql/core": "0.3.0",
    "@uiw/react-codemirror": "^4.25.1",
    "@xyflow/react": "^12.8.2",
    "jszip": "^3.10.1",
    "next": "15.5.4",
    "react": "19.3.1",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.2"
  }
}
