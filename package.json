{
  "name": "json-to-sql",
  "version": "0.1.0",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:core && next dev --turbopack",
    "build:core": "npm run build -w @json-to-sql/core",
    "build:cli": "npm run build -w @json-to-sql/cli",
    "build:packages": "npm run build:core && npm run build:cli",
    "build": "npm run build:packages && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test -w @json-to-sql/core",
    "test:e2e": "playwright test",
    "cli": "npm run build:packages && node packages/cli/dist/cli.js"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@json-to-sql/core": "0.1.0",
    "@uiw/react-codemirror": "^4.25.1",
    "@xyflow/react": "^12.8.2",
    "jszip": "^3.10.1",
    "next": "15.5.4",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.2"
  }
}
