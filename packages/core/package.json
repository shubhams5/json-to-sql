{
  "name": "@json-to-sql/core",
  "version": "0.3.0",
  "description": "JSON to SQL schema inference, dialect SQL generation, and CRUD codegen",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhams5/json-to-sql.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shubhams5/json-to-sql#readme",
  "bugs": {
    "url": "https://github.com/shubhams5/json-to-sql/issues"
  },
  "keywords": [
    "json",
    "sql",
    "schema",
    "prisma",
    "typeorm",
    "codegen"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
